{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#FFFFFF",
    "pos1": "#3a1c54",
    "pos2": "#553079",
    "pos3": "#724699",
    "pos4": "#9362bc",
    "pos5": "#bb8ae1"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:pos1",
          "foreground": "p:white",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "properties": {
              "windows": "\ue70f"
            },
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "p:pos2",
          "foreground": "p:white",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
		  "template": " {{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "p:pos3",
          "foreground": "p:white",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .HostName }} ",
		  "type": "session"
        },
        {
          "background": "p:pos4",
          "foreground": "p:white",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .AbsolutePWD }} ",
          "type": "path"
        },
        {
          "background": "p:pos5",
          "foreground": "p:white",
          "properties": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        }
      ],
      "type":"prompt"
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow":"hide",
      "segments": [
        {
          "type": "sysinfo",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "foreground": "p:white",
          "background": "#8f43f3",
          "template": "  {{ round .PhysicalPercentUsed .Precision }}% ",
          "properties": {
            "precision": 2
          }
        },
        {
            "type": "battery",
            "style": "powerline",
            "powerline_symbol": "",
            "foreground": "p:white",
            "background": "#ffeb3b",
            "background_templates": [
              "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
              "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
              "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
            ],
            "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }} ",
            "properties": {
              "discharging_icon": "\udb85\udfe4 ",
              "charging_icon": "\udb80\udc84 ",
              "charged_icon": "\udb85\udfe2 "
            }
          },
          {
            "type": "connection",
            "style": "powerline",
            "background": "#8822ee",
            "foreground": "p:white",
            "powerline_symbol": "",
            "template":" {{ if eq .Type \"wifi\"}}\uf1eb{{ else if eq .Type \"ethernet\"}}\udb80\ude00{{ else if eq .Type \"bluetooth\"}}\uf293{{ else if eq .Type \"cellular\"}}\udb80\udd1c{{ else }}\uea76{{ end }}  "
          }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}